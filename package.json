{
  "name": "pbgc-design-system",
  "version": "1.7.0",
  "private": true,
  "description": "PBGC design system: tokens, accessible React components, and Storybook.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "reference": "node scripts/build-reference.mjs",
    "prestorybook": "npm run tokens",
    "prebuild-storybook": "npm run tokens",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:a11y": "node scripts/a11y-check.mjs",
    "test": "npm run tokens:check && npm run test:numeric && npm run test:fields && npm run vanilla && npm run reference && npm run build-storybook && npm run test:a11y && npm run test:reference && npm run test:behavior",
    "vanilla": "node scripts/build-vanilla.mjs",
    "test:behavior": "node scripts/behavior-check.mjs",
    "test:numeric": "node scripts/numeric-check.mjs",
    "test:fields": "node scripts/field-check.mjs",
    "test:reference": "node scripts/reference-check.mjs"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.65.0",
    "storybook": "^10.6.6",
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./components.css": "./src/styles/components.css",
    "./behaviors": "./src/behaviors/index.js",
    "./pbgc.js": "./dist/pbgc.js",
    "./pbgc.css": "./dist/pbgc.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
